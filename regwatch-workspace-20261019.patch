+.ws-editor { display:block; box-sizing:border-box; width:100%; min-height:38px; border:1px solid transparent; border-radius:4px; resize:none; overflow:hidden; padding:7px 6px; background:transparent; color:var(--text); font:inherit; font-size:.86rem; line-height:1.7; overflow-wrap:anywhere; }
+.ws-editor:hover { border-color:var(--line); }
+.ws-editor:focus { outline:2px solid var(--blue); outline-offset:1px; }
+.ws-editor::placeholder { color:var(--muted); opacity:.75; }
+.ws-heading { font-size:1rem; font-weight:600; }
+.ws-task { display:grid; grid-template-columns:18px minmax(0,1fr) 30px; gap:8px; align-items:start; }
