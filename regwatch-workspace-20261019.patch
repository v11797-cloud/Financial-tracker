+  }
+  main {
+    padding-top:16px
+  }
+  .data-status {
+    padding:7px 10px
+  }
+  .data-status .status-dot {
+    display:none
+  }
+  .data-status .text-button {
+    margin-left:0
+  }
+  .metrics {
+    gap:8px
+  }
+  .metric {
+    padding-top:8px;
+    padding-bottom:8px
+  }
+  .metric strong {
+    font-size:1.6rem;
+    line-height:1.3
+  }
+  .mobile-filter-toggle {
+    display:flex;
+    width:100%;
+    align-items:center;
+    justify-content:space-between;
+    text-align:left;
+    font-size:.8125rem;
+    color:var(--muted);
+    padding:8px 0 0;
+    min-height:34px
+  }
+  #filter-controls {
+    display:none
+  }
+  #filter-controls.is-open {
+    display:block
+  }
+  .sidebar nav {
+    scrollbar-width:thin
+  }
+  .filter-area {
+    padding-top:10px
+  }
+  .search-wrap input {
+    min-height:36px;
+    padding-top:8px;
+    padding-bottom:8px
+  }
+}
+
+/* Separate collection timestamps: a failed provider never hides other sources. */
+.source-status { color:var(--muted); font-size:.75rem; margin:-4px 0 12px; overflow-wrap:anywhere; }
+.source-error { color:var(--amber); }
+.source-bridge { max-width:640px; padding:32px 20px; }
+.source-bridge p, .source-bridge form { margin-top:20px; }
+
+.collection-panel { margin: 12px 0 20px; padding: 14px 16px; border: 1px solid var(--border, #26364a); border-radius: 8px; background: #101c2c; font-size: 12px; }
+.collection-actions, .collection-details { display: flex; align-items: center; flex-wrap: wrap; gap: 10px 20px; }
+.collection-panel a { color: #91bcdf; }
+.collection-panel p { margin: 9px 0; line-height: 1.6; }
+.collection-help { color: #9caec4; font-size: 11px; }
+#collect-button { border-color: #507a9f; padding: 8px 14px; }
+#collect-button:disabled { opacity: .65; cursor: wait; }
+
+@media (max-width: 760px) {
+  .metrics .all-metric { grid-column: 1 / -1; }
+}
+
+.collection-badge { display:inline-block; border:1px solid #436176; border-radius:4px; padding:2px 6px; font-size:11px; line-height:1.4; }
+.collection-badge.historical { color:#bed0df; background:#1a2938; }
+.collection-badge.recent { color:#a4dfc3; background:#152e28; border-color:#326c56; }
+.collection-legend { color:#9caec4; font-size:12px; line-height:1.7; padding:10px 18px; margin:0; border-top:1px solid var(--line); }
+.collection-detail { line-height:1.7; }
