+.ws-task-add .ws-button { flex-shrink:0; margin-top:3px; color:var(--blue); }
+.ws-reg-link { display:block; padding-left:0; text-align:left; font-weight:600; line-height:1.7; overflow-wrap:anywhere; max-width:100%; }
+.ws-reg-meta { margin:2px 0 6px; color:var(--muted); font-size:.75rem; overflow-wrap:anywhere; }
