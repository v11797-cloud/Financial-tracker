+.ws-menu-options > button:hover { background:#22364e; }
+.ws-menu-options > button:disabled { color:var(--muted); opacity:.45; }
+.ws-help { font-size:.75rem; line-height:1.7; color:var(--muted); }
+.ws-help p { padding:0 8px; margin:4px 0 8px; overflow-wrap:anywhere; }
+.ws-blocks { max-height:380px; overflow:auto; scrollbar-gutter:stable; padding:0 20px; overscroll-behavior:contain; }
+.ws-block { padding:12px 0 14px; border-top:1px solid var(--line); min-width:0; }
+.ws-block-bar { display:flex; align-items:center; justify-content:space-between; gap:8px; margin-bottom:5px; }
