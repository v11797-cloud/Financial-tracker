+.rw-agent-trigger { position:fixed; right:24px; bottom:calc(24px + env(safe-area-inset-bottom)); z-index:80; display:flex; align-items:center; gap:8px; border:1px solid #91c4ff; border-radius:28px; background:#285b91; color:#fff; padding:13px 18px; font:inherit; font-size:13px; font-weight:700; box-shadow:0 5px 22px #0006; }
