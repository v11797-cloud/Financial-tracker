+.ws-empty { text-align:center; padding:24px 0; color:var(--muted); font-size:.82rem; }
+.ws-footer { display:flex; flex-wrap:wrap; align-items:center; gap:6px 12px; padding:10px 20px 12px; color:var(--muted); font-size:.72rem; line-height:1.7; overflow-wrap:anywhere; }
+.ws-footer .text-button { font-size:inherit; }
